# Copy this file to .env and fill in the Sandbox app credentials.
# .env stays on this machine. Do not commit it or paste it into chat.
# Live PayPal credentials will be refused. PAYPAL_MODE must stay sandbox.

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_RETURN_URL=http://127.0.0.1:8000/payments/return
PAYPAL_CANCEL_URL=http://127.0.0.1:8000/payments/cancel

# mock uses a built-in parser and does not call a paid model.
# llm calls an OpenAI-compatible POST {LLM_API_BASE}/chat/completions.
AGENT_MODE=mock
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# External merchant search. Leave this empty until you have a Channel3 key.
# The server sends it only as the x-api-key header to api.trychannel3.com.
CHANNEL3_API_KEY=
